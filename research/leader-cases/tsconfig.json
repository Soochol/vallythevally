{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../../web/node_modules/@types"],
    "lib": ["ES2023", "DOM"],
    "paths": { "lightweight-charts": ["../../web/node_modules/lightweight-charts"], "@playwright/test": ["../../web/node_modules/@playwright/test"] }
  },
  "include": ["*.ts", "fixtures/*.ts", "browser/*.ts"]
}
