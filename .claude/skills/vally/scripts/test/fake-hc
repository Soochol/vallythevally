#!/usr/bin/env bash
# Fake hc for vally script tests, shaped like real hc 0.1.19 JSON.
# State: $FAKE_DIR/terminals.json {"terminals":[{address,name,cwd,state,status:{state},labels}]}.
# Every call is appended to $FAKE_DIR/hc.log. FAKE_HC_FAIL=<command> makes that command fail.
set -euo pipefail
db=$FAKE_DIR/terminals.json
[ -f "$db" ] || echo '{"terminals":[]}' > "$db"
printf '%s\n' "$*" >> "$FAKE_DIR/hc.log"
cmd=$1; shift
[ "${FAKE_HC_FAIL-}" != "$cmd" ] || { echo '{"error":{"kind":"unavailable"}}' >&2; exit 1; }
save() { jq "$@" "$db" > "$db.tmp" && mv "$db.tmp" "$db"; }
find_t='.terminals[] | select(.address == $t or .name == $t)'
case $cmd in
  ls)
    filter='select(.state == "live")'
    while [ $# -gt 0 ]; do
      if [ "$1" = --label ]; then k=${2%%=*} v=${2#*=}; filter="$filter | select(.labels[\"$k\"] == \"$v\")"; shift; fi
      shift
    done
    jq "{hidden_finished: 0, terminals: [.terminals[] | $filter | {address, name, cwd, status: .status.state, state}]}" "$db" ;;
  get)
    out=$(jq --arg t "$1" "$find_t" "$db")
    [ -n "$out" ] || { echo '{"error":{"kind":"not_found"}}' >&2; exit 3; }
    echo "$out" ;;
  run)
    name='' cwd='' labels='{}'
    while [ $# -gt 0 ]; do
      case $1 in
        --name) name=$2; shift;;
        --cwd) cwd=$2; shift;;
        --label) labels=$(jq --arg k "${2%%=*}" --arg v "${2#*=}" '. + {($k): $v}' <<<"$labels"); shift;;
        --) shift; break;;
        --*) ;;
        *) break;;
      esac
      shift
    done
    addr=t$(( $(jq '.terminals | length' "$db") + 100 ))
    save --arg a "$addr" --arg n "$name" --arg c "$cwd" --argjson l "$labels" \
      '.terminals += [{address: $a, name: $n, cwd: $c, state: "live", status: {app: "claude-code", state: "working"}, labels: $l}]'
    echo "{\"address\":\"$addr\",\"first_message\":{\"sent\":${FAKE_SENT:-true},\"started\":true,\"turn\":0}}" ;;
  send)
    st=$(jq -r --arg t "$1" "$find_t | .status.state" "$db")
    [ "$st" != blocked ] || { echo '{"error":{"kind":"blocked"}}' >&2; exit 9; } ;;
  kill)
    save --arg t "$1" "($find_t | .state) = \"finished\"" ;;
  rm)
    st=$(jq -r --arg t "$1" "$find_t | .state" "$db")
    [ "$st" = finished ] || { echo '{"error":{"kind":"status_mismatch"}}' >&2; exit 10; }
    save --arg t "$1" "del($find_t)"; echo "{\"removed\":\"$1\"}" ;;
  label) ;;
  *) echo "fake hc: unsupported $cmd" >&2; exit 1 ;;
esac
