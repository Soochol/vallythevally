#!/usr/bin/env bash
# Fake gh for vally script tests. Answers from JSON files in $FAKE_DIR/gh/:
# pr-<n>.json for `gh pr view <n>`, pr-list.json for `gh pr list`, issue-list.json for `gh issue list`.
set -euo pipefail
printf '%s\n' "$*" >> "$FAKE_DIR/gh.log"
jq_expr='.'
args=("$@")
for i in "${!args[@]}"; do [ "${args[$i]}" = --jq ] && jq_expr=${args[$((i+1))]}; done
case "$1 $2" in
  "pr view") file=$FAKE_DIR/gh/pr-$3.json ;;
  "pr list") file=$FAKE_DIR/gh/pr-list.json ;;
  "issue list") file=$FAKE_DIR/gh/issue-list.json ;;
  *) echo "fake gh: unsupported $*" >&2; exit 1 ;;
esac
[ -f "$file" ] || echo '[]' > "$file"
jq -r "$jq_expr" "$file"
