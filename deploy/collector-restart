#!/bin/sh
set -eu
self="$(cd "$(dirname "$0")" && pwd)/collector-restart"
service="${VALLY_COLLECTOR_SERVICE:-vally-collector.service}"
collector="${VALLY_COLLECTOR_BIN:-$HOME/.local/bin/collector}"
data_dir="${VALLY_DATA:-}"
schedule_args="${VALLY_COLLECTOR_SCHEDULE_ARGS:-}"
allowance="${VALLY_COLLECTOR_FINALIZE_MINUTES:-120}"
stable="${VALLY_COLLECTOR_STABLE_SECONDS:-10}"
reservation="vally-collector-restart"
tab="$(printf '\t')"

bin_dir="$(dirname "$collector")"
unit_dir="${VALLY_SYSTEMD_USER_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}"
reload_pending="$unit_dir/.vally-collector-reload-pending"
install_verdict="$unit_dir/.vally-collector-install-verdict"
lock_file="$unit_dir/.vally-collector-deploy.lock"
restart_lock_file="$unit_dir/.vally-collector-restart.lock"
last_restart_file="$unit_dir/.vally-collector-last-restart"
alert_script="$bin_dir/vally-collector-alert-telegram"
stable_max=600
lock_max=3600
lock_wait_seconds="${VALLY_COLLECTOR_LOCK_SECONDS:-120}"
install_verdict_minutes=30
alert_on_failure=no
daemon_unit_promoted=no

check_window() {
    judge="$collector"
    pending_judge="$(readlink -f "$collector" || echo "$collector").next"
    [ -x "$pending_judge" ] && judge="$pending_judge"
    "$judge" restart-window --data "${data_dir:-$HOME/vally-data/hoga}" --finalize-allowance-minutes "$allowance" $schedule_args
}

resolve_link() {
    if resolved="$(readlink -f "$1")"; then
        printf '%s\n' "$resolved"
    elif [ -L "$1" ]; then
        echo "vally-deploy collector-restart: $1의 심볼릭 링크를 풀지 못해 건드리지 않습니다" >&2
        return 1
    else
        printf '%s\n' "$1"
    fi
}

acquire_lock() {
    mkdir -p "$unit_dir"
    exec 9>"$lock_file"
    if ! command -v flock >/dev/null 2>&1; then
        echo "vally-deploy collector-restart: flock이 없어 동시 실행을 막지 못합니다" >&2
        return 0
    fi
    if ! flock -w "$lock_wait_seconds" 9; then
        echo "vally-deploy collector-restart: 다른 배포 단계가 ${lock_wait_seconds}초 넘게 잠금을 쥐고 있습니다($lock_file)" >&2
        return 1
    fi
}

release_lock() {
    exec 9>&-
}

alert_failure() {
    [ "$alert_on_failure" = yes ] || return 0
    [ -x "$alert_script" ] || return 0
    "$alert_script" "$1" || echo "vally-deploy collector-restart: 경보를 보내지 못했습니다" >&2
}

roll_back() {
    for real in "$@"; do
        if [ -e "$real.prev" ]; then
            { ln -f "$real" "$real.next" && mv -f "$real.prev" "$real"; } || echo "vally-deploy collector-restart: $real을 되돌리지 못했습니다" >&2
        else
            mv -f "$real" "$real.next" || echo "vally-deploy collector-restart: $real을 되돌리지 못했습니다" >&2
        fi
    done
}

fail_promotion() {
    reason="$1"
    shift
    roll_back "$@"
    release_lock
    echo "vally-deploy collector-restart: $reason. 옮긴 파일을 되돌려 옛 판 그대로 두었습니다" >&2
    alert_failure "[수집 경보] 수집 데몬 새 판 적용이 멈췄다: $reason. 옛 판 그대로 돌고 있다. 마감 뒤 collector-restart를 다시 돌려라."
    return 1
}

promote_pending() {
    daemon_unit_promoted=no
    acquire_lock || return 1
    set --
    for target in "$collector" "$bin_dir/vally-collector-alert-telegram" "$bin_dir/vally-collector-restart" "$unit_dir/vally-collector.service" "$unit_dir/vally-collector-alert.service" "$unit_dir/vally-financials.service"; do
        if ! real="$(resolve_link "$target")"; then
            fail_promotion "$target의 심볼릭 링크를 풀지 못함" "$@"
            return 1
        fi
        [ -e "$real.next" ] || continue
        case "$target" in
            "$unit_dir"/*) : > "$reload_pending" ;;
        esac
        case "$target" in
            "$unit_dir/vally-collector.service") daemon_unit_promoted=yes ;;
        esac
        if { [ ! -e "$real" ] || ln -f "$real" "$real.prev"; } && mv -f "$real.next" "$real"; then
            set -- "$@" "$real"
            echo "옆 자리의 새 판을 제자리로 옮김: $real"
        else
            rm -f "$real.prev"
            fail_promotion "$real을 옮기지 못함" "$@"
            return 1
        fi
    done
    if [ -e "$reload_pending" ]; then
        if systemctl --user daemon-reload; then
            rm -f "$reload_pending"
            echo "유닛이 바뀌어 daemon-reload를 했습니다"
        else
            fail_promotion "daemon-reload에 실패함" "$@"
            return 1
        fi
    fi
    for real in "$@"; do
        rm -f "$real.prev"
    done
    release_lock
}

retry_reload() {
    acquire_lock || return 1
    if [ -e "$reload_pending" ]; then
        if systemctl --user daemon-reload; then
            rm -f "$reload_pending"
            echo "앞서 실패한 daemon-reload를 다시 했습니다"
        else
            release_lock
            echo "vally-deploy collector-restart: 앞서 실패한 daemon-reload가 또 실패했습니다" >&2
            return 1
        fi
    fi
    release_lock
}

before_start() {
    alert_on_failure=yes
    promote_pending || return 0
    if [ "$daemon_unit_promoted" = yes ]; then
        if systemd-run --user --unit="$reservation-after-start" --on-active=10 --collect systemctl --user restart "$service" >/dev/null; then
            echo "데몬 유닛이 바뀌었으니 시작 뒤 10초에 한 번 다시 시작해 새 유닛 정의를 씁니다"
        else
            echo "vally-deploy collector-restart: 시작 뒤 재시작을 걸지 못했습니다. 새 유닛 정의는 다음 재시작부터 쓰입니다" >&2
        fi
    fi
}

seconds_digits() {
    digits="${1#"${1%%[!0]*}"}"
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    case "$digits" in
        ''|?????*) return 1 ;;
    esac
    [ "$digits" -le "$2" ] || return 1
    printf '%s\n' "$digits"
}

visible_text() {
    printf '%s' "$1" | LC_ALL=C od -An -v -tx1 | LC_ALL=C awk '
        function value(hex) { return (index("0123456789abcdef", substr(hex, 1, 1)) - 1) * 16 + index("0123456789abcdef", substr(hex, 2, 1)) - 1 }
        BEGIN { ORS = ""; names[10] = "\\n"; names[9] = "\\t"; names[13] = "\\r"; names[92] = "\\\\" }
        { for (field = 1; field <= NF; field++) byte[++count] = value($field) }
        function continuation(position, low, high) { return position <= count && byte[position] >= low && byte[position] <= high }
        function sequence_length(i,    lead) {
            lead = byte[i]
            if (lead < 128) return 1
            if (lead >= 194 && lead <= 223) return continuation(i + 1, 128, 191) ? 2 : 0
            if (lead == 224) return continuation(i + 1, 160, 191) && continuation(i + 2, 128, 191) ? 3 : 0
            if (lead == 237) return continuation(i + 1, 128, 159) && continuation(i + 2, 128, 191) ? 3 : 0
            if (lead >= 225 && lead <= 239) return continuation(i + 1, 128, 191) && continuation(i + 2, 128, 191) ? 3 : 0
            if (lead == 240) return continuation(i + 1, 144, 191) && continuation(i + 2, 128, 191) && continuation(i + 3, 128, 191) ? 4 : 0
            if (lead == 244) return continuation(i + 1, 128, 143) && continuation(i + 2, 128, 191) && continuation(i + 3, 128, 191) ? 4 : 0
            if (lead >= 241 && lead <= 243) return continuation(i + 1, 128, 191) && continuation(i + 2, 128, 191) && continuation(i + 3, 128, 191) ? 4 : 0
            return 0
        }
        END {
            for (i = 1; i <= count; i++) {
                code = byte[i]
                if (code in names) print names[code]
                else if (code < 32 || code == 127) printf "\\x%02x", code
                else if (code < 128) printf "%c", code
                else if (!(length_here = sequence_length(i))) printf "\\x%02x", code
                else if (code == 194 && byte[i + 1] < 160) { printf "\\u00%02x", byte[i + 1]; i += 1 }
                else if (code == 226 && byte[i + 1] == 128 && byte[i + 2] == 168) { print "\\u2028"; i += 2 }
                else if (code == 226 && byte[i + 1] == 128 && byte[i + 2] == 169) { print "\\u2029"; i += 2 }
                else { for (k = 0; k < length_here; k++) printf "%c", byte[i + k]; i += length_here - 1 }
            }
        }'
}

check_lock_seconds() {
    if ! lock_wait_seconds="$(seconds_digits "$lock_wait_seconds" "$lock_max")"; then
        printf '%s\n' "vally-deploy collector-restart: VALLY_COLLECTOR_LOCK_SECONDS는 1 이상 ${lock_max} 이하의 정수여야 합니다($(visible_text "${VALLY_COLLECTOR_LOCK_SECONDS:-120}"))" >&2
        return 1
    fi
}

check_stable_seconds() {
    if ! stable="$(seconds_digits "$stable" "$stable_max")"; then
        printf '%s\n' "vally-deploy collector-restart: VALLY_COLLECTOR_STABLE_SECONDS는 1 이상 ${stable_max} 이하의 정수여야 합니다($(visible_text "${VALLY_COLLECTOR_STABLE_SECONDS:-10}"))" >&2
        return 1
    fi
}

case "${1:-}" in
    --validate) check_stable_seconds && check_lock_seconds || exit 2; exit 0 ;;
    --check) check_window; exit 0 ;;
    --promote) check_lock_seconds || exit 2; promote_pending; exit 0 ;;
    --retry-reload) check_lock_seconds || exit 2; retry_reload; exit 0 ;;
    --before-start) check_lock_seconds || exit 2; before_start; exit 0 ;;
esac

check_stable_seconds || exit 2
check_lock_seconds || exit 2
restart_lock_wait_seconds=$((stable + lock_wait_seconds))

cancel_reservation() {
    systemctl --user stop "$reservation.timer" 2>/dev/null || true
}

restart_generation() {
    [ -e "$last_restart_file" ] || { echo 0; return 0; }
    [ -r "$last_restart_file" ] || return 0
    read -r generation < "$last_restart_file" || return 0
    case "$generation" in
        ''|*[!0-9]*) return 0 ;;
    esac
    generation="${generation#"${generation%%[!0]*}"}"
    case "$generation" in
        ????????????????*) return 0 ;;
    esac
    printf '%s\n' "${generation:-0}"
}

running_files_fingerprint() {
    for file in "$collector" "$unit_dir/vally-collector.service"; do
        { cksum < "$file"; } 2>/dev/null || echo missing
    done
}

restarted_with_same_files_since() {
    [ -n "$1" ] || return 1
    finished_generation="$(restart_generation)"
    [ -n "$finished_generation" ] || return 1
    [ "$finished_generation" -gt "$1" ] || return 1
    { read -r _ && fingerprint="$(cat)"; } < "$last_restart_file" || return 1
    [ "$fingerprint" = "$2" ]
}

restart_and_watch() {
    asked_generation="$(restart_generation)"
    mkdir -p "$unit_dir"
    exec 8>"$restart_lock_file"
    if command -v flock >/dev/null 2>&1 && ! flock -w "$restart_lock_wait_seconds" 8; then
        echo "vally-deploy collector-restart: 다른 재시작이 ${restart_lock_wait_seconds}초 넘게 끝나지 않습니다($restart_lock_file)" >&2
        exit 1
    fi
    promote_pending
    files_fingerprint="$(running_files_fingerprint)"
    if restarted_with_same_files_since "$asked_generation" "$files_fingerprint" && systemctl --user is-active --quiet "$service"; then
        echo "$service는 이 실행이 시작된 뒤 다른 재시작이 같은 판으로 다시 시작하고 확인까지 마쳤으므로 다시 시작하지 않습니다"
        return 0
    fi
    generation_before="$(restart_generation)"
    rm -f "$last_restart_file"
    printf '%s\n' "${generation_before:-0}" > "$last_restart_file"
    systemctl --user restart "$service"
    elapsed=0
    while [ "$elapsed" -lt "$stable" ]; do
        sleep 1
        if ! systemctl --user is-active --quiet "$service"; then
            echo "vally-deploy collector-restart: $service가 재시작 ${elapsed}초 만에 active가 아닙니다. journalctl --user -u $service 를 확인하세요" >&2
            exit 1
        fi
        elapsed=$((elapsed + 1))
    done
    { printf '%s\n' "$((${generation_before:-0} + 1))"; printf '%s\n' "$files_fingerprint"; } > "$last_restart_file"
    echo "$service를 재시작했고 ${stable}초 동안 active입니다"
}

install_judged_now() {
    [ -e "$install_verdict" ] || return 1
    [ -n "$(find "$install_verdict" -mmin "-$install_verdict_minutes" 2>/dev/null)" ] || return 1
    [ "$(cat "$install_verdict")" = now ]
}

if [ "${1:-}" = "--scheduled" ]; then
    alert_on_failure=yes
    rm -f "$install_verdict"
    echo "예약된 재시작: 마감 정리 여유가 끝난 시각이라 바로 재시작합니다"
    restart_and_watch
    exit 0
fi

if install_judged_now; then
    rm -f "$install_verdict"
    echo "재시작: 설치 단계가 수집 시간 밖이라 판정하고 새 판을 제자리에 두었으므로 같은 판정을 따릅니다"
    cancel_reservation
    restart_and_watch
    exit 0
fi
rm -f "$install_verdict"

if ! verdict="$(check_window)"; then
    echo "vally-deploy collector-restart: 재시작해도 되는지 판정하지 못했습니다($collector restart-window 실패). 재시작하지 않았습니다" >&2
    exit 1
fi
decision="${verdict%%"$tab"*}"
rest="${verdict#*"$tab"}"
case "$decision" in
    now)
        echo "재시작: $rest"
        cancel_reservation
        restart_and_watch
        ;;
    wait)
        until="${rest%%"$tab"*}"
        reason="${rest#*"$tab"}"
        cancel_reservation
        systemd-run --user --unit="$reservation" --on-calendar="$until" --setenv=VALLY_COLLECTOR_SERVICE="$service" --setenv=VALLY_COLLECTOR_STABLE_SECONDS="$stable" --setenv=VALLY_COLLECTOR_BIN="$collector" --setenv=VALLY_SYSTEMD_USER_DIR="$unit_dir" --collect "$self" --scheduled >/dev/null
        echo "재시작하지 않고 예약: $until에 한 번 재시작합니다. 이유: $reason"
        ;;
    *)
        echo "vally-deploy collector-restart: restart-window의 출력을 읽을 수 없습니다: $verdict" >&2
        exit 1
        ;;
esac
