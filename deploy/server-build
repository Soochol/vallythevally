#!/bin/sh
set -eu
root="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="${VALLY_CARGO_BIN:-$HOME/.cargo/bin}:$PATH"
cd "$root"
head="$(git rev-parse HEAD)"
if [ -n "${ORCH_DEPLOY_SHA:-}" ] && [ "$ORCH_DEPLOY_SHA" != "$head" ]; then
    echo "vally-deploy server-build: checkout HEAD $head가 배포 대상 $ORCH_DEPLOY_SHA와 다릅니다" >&2
    exit 1
fi
lock="$(git rev-parse --path-format=absolute --git-common-dir)/compile.lock"
exec flock "$lock" env CARGO_BUILD_JOBS="${VALLY_BUILD_JOBS:-4}" cargo build --locked --release -p server
