[Unit]
Description=Vally 프리뷰 서버 (vally-dev, 모의 투자구분)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/apps/vallythevally-dev
Environment=VALLY_KIWOOM_ENV=mock
Environment=VALLY_BIND=127.0.0.1:8082
Environment=VALLY_SCREENER_UPDATE_ON_START=off
Environment=VALLY_LOCK_PATH=%t/vallythevally/dev/server.lock
Environment=VALLY_TOKEN_PATH=%h/.local/state/vallythevally/dev/token.json
Environment=VALLY_KIWOOM_KEY_PATH=%h/.local/state/vallythevally/dev/kiwoom-key.json
Environment=VALLY_DB_PATH=%h/vally-data/dev/vally.db
Environment=VALLY_SCREENER_DB_PATH=%h/vally-data/dev/screener.duckdb
Environment=VALLY_FINANCIAL_DB_PATH=%h/vally-data/server/financials.db
Environment=VALLY_HOGA_DATA_DIR=%h/vally-data/hoga
Environment=VALLY_SHARED_DATA_DIR=%h/vally-data/hoga/shared
Environment=VALLY_STATIC_DIR=%h/apps/vallythevally-dev/web/dist
ExecStart=%h/apps/vallythevally-dev/target/release/vally-server
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=default.target
