#!/bin/sh
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/.." && pwd)"
bin_dir="${VALLY_COLLECTOR_BIN_DIR:-$HOME/.local/bin}"
unit_dir="${VALLY_SYSTEMD_USER_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}"
built="$root/target/release/collector"
tab="$(printf '\t')"
install_verdict="$unit_dir/.vally-collector-install-verdict"
lock_file="$unit_dir/.vally-collector-deploy.lock"
lock_wait_seconds="${VALLY_COLLECTOR_LOCK_SECONDS:-120}"
VALLY_COLLECTOR_BIN="$bin_dir/collector" "$here/collector-restart" --validate || exit 2
if [ ! -x "$built" ]; then
    echo "vally-deploy collector-install: $built가 없습니다. deploy/collector-build를 먼저 돌리세요" >&2
    exit 1
fi

resolve_link() {
    if resolved="$(readlink -f "$1")"; then
        printf '%s\n' "$resolved"
    elif [ -L "$1" ]; then
        echo "vally-deploy collector-install: $1의 심볼릭 링크를 풀지 못해 건드리지 않습니다" >&2
        return 1
    else
        printf '%s\n' "$1"
    fi
}

acquire_lock() {
    mkdir -p "$unit_dir"
    exec 9>"$lock_file"
    if ! command -v flock >/dev/null 2>&1; then
        echo "vally-deploy collector-install: flock이 없어 동시 실행을 막지 못합니다" >&2
        return 0
    fi
    if ! flock -w "$lock_wait_seconds" 9; then
        echo "vally-deploy collector-install: 다른 배포 단계가 ${lock_wait_seconds}초 넘게 잠금을 쥐고 있습니다($lock_file)" >&2
        exit 1
    fi
}

release_lock() {
    exec 9>&-
}

stage() {
    source="$1"
    target="$2"
    mode="$3"
    real="$(resolve_link "$target")" || exit 1
    pending="$real.next"
    if [ -e "$real" ] && cmp -s "$source" "$real"; then
        rm -f "$pending"
        echo "그대로: $target"
        return 0
    fi
    if [ -e "$pending" ] && cmp -s "$source" "$pending"; then
        chmod "$mode" "$pending"
        echo "이미 옆 자리에 있음: $pending"
        return 0
    fi
    mkdir -p "$(dirname "$real")"
    partial="$(mktemp "$pending.part.XXXXXX")"
    if ! { cp "$source" "$partial" && chmod "$mode" "$partial" && mv -f "$partial" "$pending"; }; then
        rm -f "$partial"
        echo "vally-deploy collector-install: $pending을 쓰지 못했습니다" >&2
        exit 1
    fi
    echo "옆 자리에 둠: $pending"
}

stage_if_installed() {
    if [ -e "$2" ]; then
        stage "$@"
    else
        echo "설치 안 됨, 건너뜀: $2 (처음 설치는 docs/hoga-collector.md의 설치 절)"
    fi
}

daemon_installed=no
[ -e "$bin_dir/collector" ] && daemon_installed=yes

acquire_lock
stage "$built" "$bin_dir/collector" 755
stage "$here/collector-restart" "$bin_dir/vally-collector-restart" 755
stage_if_installed "$here/systemd/vally-collector-alert-telegram" "$bin_dir/vally-collector-alert-telegram" 755
for unit in vally-collector.service vally-collector-alert.service; do
    stage_if_installed "$here/systemd/$unit" "$unit_dir/$unit" 644
done

decision=wait
if [ "$daemon_installed" = no ]; then
    decision=now
elif verdict="$(VALLY_COLLECTOR_BIN="$built" "$here/collector-restart" --check)"; then
    decision="${verdict%%"$tab"*}"
else
    echo "수집 시간인지 판정하지 못해 제자리 파일은 바꾸지 않습니다" >&2
fi

rm -f "$install_verdict"
release_lock

if [ "$decision" = now ]; then
    VALLY_COLLECTOR_BIN="$bin_dir/collector" VALLY_SYSTEMD_USER_DIR="$unit_dir" "$here/collector-restart" --promote
    printf 'now\n' > "$install_verdict"
else
    echo "수집 시간 안이라 새 판을 옆 자리(.next)에만 두었습니다. 마감 뒤 collector-restart가 제자리로 옮기고 재시작합니다"
    VALLY_COLLECTOR_BIN="$bin_dir/collector" VALLY_SYSTEMD_USER_DIR="$unit_dir" "$here/collector-restart" --retry-reload || echo "vally-deploy collector-install: 앞서 실패한 daemon-reload를 다시 하지 못했습니다. 다음 collector-restart가 다시 합니다" >&2
fi
exit 0
