#!/bin/sh
set -eu
root="$(cd "$(dirname "$0")/.." && pwd)"
if [ -z "${VALLY_NODE_BIN:-}" ]; then
    echo "vally-deploy web-build: VALLY_NODE_BIN(node와 pnpm이 있는 폴더)이 필요합니다. ls ~/.local/share/fnm/node-versions 로 버전을 찾아 ~/.local/share/fnm/node-versions/v<버전>/installation/bin 을 orch 배포 설정(~/.claude/orch/deploy.json)의 env에 VALLY_NODE_BIN으로 넣으세요" >&2
    exit 2
fi
if [ ! -x "$VALLY_NODE_BIN/pnpm" ]; then
    echo "vally-deploy web-build: $VALLY_NODE_BIN/pnpm이 없습니다. VALLY_NODE_BIN은 ~ 없이 절대 경로로 적은 node·pnpm 폴더여야 합니다" >&2
    exit 2
fi
export PATH="$VALLY_NODE_BIN:${VALLY_CARGO_BIN:-$HOME/.cargo/bin}:$HOME/.local/bin:$PATH"
export CARGO_BUILD_JOBS="${VALLY_BUILD_JOBS:-4}"
cd "$root/web"
pnpm install --frozen-lockfile
exec pnpm build
